# ==============================================================================
# Ummah-DarazListings Environment Variables Template
# Copy this file to `.env.local` and fill in your actual API credentials.
# NEVER commit `.env.local` or active production API keys to git repository.
# ==============================================================================

# Database Connection (Neon PostgreSQL)
# Example: postgresql://username:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://your_neon_db_user:your_password@ep-xxx.neon.tech/neondb?sslmode=require"

# Clerk Authentication (Next.js SDK)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Clerk Webhook Secret (Optional: for background sync)
CLERK_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"

# Anthropic Claude API Key (Server-side generation engine)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx"

# DigitalOcean Spaces / S3 Object Storage (Product Gallery Image Generator)
# Get from: https://cloud.digitalocean.com/spaces
SPACES_KEY="DO00xxxxxxxxxxxxxxxx"
SPACES_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SPACES_BUCKET="ummah-daraz-assets"
SPACES_ENDPOINT="https://sgp1.digitaloceanspaces.com"

